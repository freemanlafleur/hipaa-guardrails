  "custom_rules": [
    {
      "id": "STORAGE-PUBLIC",
      "description": "Public bucket or public-read object for storage",
      "regex": "(public-read(-write)?\\b|createBucket\\([^)]*public\\s*:\\s*true|BlockPublicAcls\\s*[:=]\\s*false)",
      "paths": [
        "**/*"
      ],
      "action": "deny",
      "message": "Storage that can hold PHI stays private. Use private buckets and short-lived signed URLs.",
      "exclude_paths": [
        "**/*.md"
      ]
    },
    {
      "id": "TLS-PLAIN-HTTP",
      "description": "Plain http:// URL to a non-local host",
      "regex": "http://(?!localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|\\[::1\\]|host\\.docker\\.internal|[a-z0-9.-]*\\.(local|test|example|internal|localhost)\\b|example\\.(com|org|net)\\b|(www\\.)?w3\\.org|schemas\\.|json-schema\\.org|purl\\.org|xmlns\\.|ns\\.adobe\\.com|www\\.apple\\.com/DTDs|scripts\\.sil\\.org|loinc\\.org|snomed\\.info|(terminology\\.)?hl7\\.org|unitsofmeasure\\.org|www\\.nlm\\.nih\\.gov|hl7\\.org)[a-z0-9-]+\\.[a-z]",
      "paths": [
        "**/*"
      ],
      "action": "warn",
      "message": "PHI moves only over TLS. Use https:// unless this is local or a namespace URI.",
      "exclude_paths": [
        "**/*.txt",
        "**/LICENSE*",
        "**/*.md"
      ],
      "skip_strict": true
    }
  ],
  "blocked_commands": [
    {
      "id": "CMD-NO-VERIFY",
      "regex": "\\bgit\\b[^|;&]*\\b(commit|push|merge|rebase|am|cherry-pick)\\b[^|;&]*\\s--no-verify\\b|\\bgit\\s+commit\\b[^|;&]*\\s-[a-zA-Z]*n[a-zA-Z]*(\\s|$)",
      "action": "deny",
      "message": "Don't skip git hooks; they run the same HIPAA checks as CI."
    },
    {
      "id": "CMD-DB-DUMP",
      "regex": "\\b(pg_dump|pg_dumpall|supabase\\s+db\\s+dump|mysqldump|mongodump)\\b",
      "action": "ask",
      "message": "A dump of a database that holds PHI is PHI. Dump only synthetic or schema-only data on a dev machine (pg_dump --schema-only)."
    },
    {
      "id": "CMD-GIT-ADD-FORCE",
      "regex": "\\bgit\\s+add\\b[^|;&]*\\s(-f|--force)\\b",
      "action": "ask",
      "message": "Force-adding an ignored file can commit secrets or PHI exports."
    },
    {
      "id": "GUARD-HOOKSPATH",
      "regex": "core\\.hooksPath",
      "action": "ask",
      "message": "Changing git's hooks path can switch off the pre-commit check."
    },
    {
      "id": "GUARD-PLUGIN-OFF",
      "regex": "\\bclaude\\s+plugins?\\s+(disable|uninstall|remove)\\b[^|;&]*hipaa-guardrails|\\bdisableAllHooks\\b",
      "action": "ask",
      "message": "This turns the HIPAA guardrails off. Only the policy owner does that."
    },
    {
      "id": "GUARD-PROTECTED-FILE",
      "regex": "\\b(rm|mv|cp|truncate|chmod|chattr|ln|unlink|git\\s+rm|git\\s+mv|git\\s+update-index)\\b[^|;&]*(\\.hipaa-guardrails|\\.githooks|\\.claude/settings|\\.github/workflows|CODEOWNERS)",
      "action": "ask",
      "message": "This changes a file that holds the guardrails or their enforcement."
    },
    {
      "id": "CMD-SKIP-HOOKS-ENV",
      "regex": "\\b(HUSKY=0|SKIP=\\S*hipaa|HIPAA_GUARDRAILS_(OFF|DISABLE)\\w*=)",
      "action": "deny",
      "message": "Don't skip the guardrails with environment variables."
    }
  ],
  "exceptions": []
}
